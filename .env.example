# ---- Site extraction ----
ANZOR_BASE_URL=https://www.anzorjewelrycorp.com
ANZOR_USER_AGENT=Mozilla/5.0 (compatible; anzorlist/0.1; +ops@anzorjewelrycorp.com)
ANZOR_REQ_PER_SEC=1.0

# ---- Brand identity (must match your GTIN exemption / Brand Registry exactly) ----
ANZOR_BRAND_NAME=Anzor Jewelry
ANZOR_MANUFACTURER=Anzor Jewelry Corp
ANZOR_BRAND_REGISTERED=false

# ---- Operator photos: images/<SKU>/01.jpg, 02.jpg ... replace the website's images ----
ANZOR_IMAGES_DIR=images

# ---- Copy generation (Anthropic) ----
ANTHROPIC_API_KEY=
ANZOR_COPY_MODEL=claude-sonnet-5
ANZOR_COPY_MODEL_ESCALATION=claude-opus-5

# ---- Pricing (per-channel fee markup, fractions) ----
PRICE_MARKUP_AMAZON=0.20
PRICE_MARKUP_EBAY=0.15
PRICE_MARKUP_ETSY=0.09

# ---- Image hosting (Cloudflare R2, S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ---- Amazon SP-API (LWA; no SigV4) ----
# One app (client id/secret); one self-authorization per region. NA covers US, CA, MX.
SPAPI_LWA_CLIENT_ID=
SPAPI_LWA_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN_NA=
SPAPI_SELLER_ID_NA=
# SPAPI_REFRESH_TOKEN_EU=
# SPAPI_SELLER_ID_EU=
ANZOR_MARKETPLACES=US

# ---- Safety: live writes stay off until you mean it ----
ANZOR_ALLOW_LIVE=false

# ---- Channels built by `anzorlist build` ----
ANZOR_CHANNELS=amazon,ebay

# ---- eBay Sell APIs (Sandbox first; `anzorlist ebay setup` lists the policy ids) ----
EBAY_ENV=SANDBOX
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=

# ---- Etsy Open API v3 (OAuth2 PKCE) ----
ETSY_API_KEY=
ETSY_CLIENT_ID=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
